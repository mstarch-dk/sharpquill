# Normalize line endings; shell scripts and Docker/CI files must stay LF even on Windows checkouts
* text=auto
*.sh text eol=lf
Dockerfile* text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.env.example text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff2 binary
