# Demo stack for the marketing screenshots (npm run marketing -- demo-up).
# Runs the normal docker-compose.yml as its own compose project, "cms-demo", so it has its own database and
# uploads volumes and never touches the dev stack. Every value here is a throwaway demo value.
POSTGRES_DB=cms_demo
POSTGRES_USER=cms_demo
POSTGRES_PASSWORD=demo-only-db-password

JWT_SECRET=demo-only-jwt-secret-not-for-real-use-0123456789

# The first admin (db-init creates it on the empty demo database); the seed logs in with it
ADMIN_EMAIL=editor@demo.example
ADMIN_PASSWORD=demo-editor-password

# Not started by the demo, but docker-compose.yml requires them
PGADMIN_EMAIL=pgadmin@demo.example
PGADMIN_PASSWORD=demo-only
UMAMI_APP_SECRET=demo-only-umami-secret
UMAMI_WEBSITE_ID=

# Ports differ from the dev defaults so both stacks can run at once
WEB_PORT=4000
ADMIN_PORT=4001
API_PORT=5100
UMAMI_PORT=4003
PGADMIN_PORT=5051
DB_PORT=5533
