# ─────────────────────────────────────────────────────────────────────────────
# Production configuration for deploy/compose.yml (one site per stack)
#   cp .env.example .env && chmod 600 .env
# Generate secrets with:  openssl rand -hex 32
# (hex on purpose: POSTGRES_PASSWORD ends up inside a URL, where base64's / + = break it)
# ─────────────────────────────────────────────────────────────────────────────

# ─── Images ─────────────────────────────────────────────────────────────────
# Registry namespace the sharpquill-{api,web,admin,db-init} images are published under (public, no login
# needed), and the version tag to run: a release such as 1.2.3, or sha-<short> for a build of main.
# Required. Pick one from the package page, e.g. https://github.com/users/mstarch-dk/packages/container/package/sharpquill-api
# `latest` only exists after the first vX.Y.Z release tag has been published; pin a version anyway.
SHARPQUILL_IMAGE_PREFIX=ghcr.io/mstarch-dk
SHARPQUILL_VERSION=
# Isolates this stack's containers and volumes; run several sites by giving each its own value and ports
COMPOSE_PROJECT_NAME=cms

# ─── Domains ────────────────────────────────────────────────────────────────
# Public site and the separate admin hostname (must be different hosts)
DOMAIN=example.com
ADMIN_DOMAIN=admin.example.com
# Optional: Umami dashboard host (only used by the bundled Caddy)
ANALYTICS_DOMAIN=analytics.example.com

# ─── Database ───────────────────────────────────────────────────────────────
POSTGRES_DB=cms
POSTGRES_USER=cms_user
POSTGRES_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD

# ─── API ────────────────────────────────────────────────────────────────────
# JWT signing secret, at least 32 characters
JWT_SECRET=CHANGE_ME_32_CHARS_MIN_USE_RANDOM_STRING

# First admin, created by db-init only while the authors table is empty.
# ADMIN_PASSWORD must be at least 12 characters; if unset a random one is printed once:
#   docker compose logs db-init
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=

# Contact form email (optional). Brevo free tier: https://app.brevo.com/settings/keys/smtp
# EMAIL_FROM_ADDRESS should use the same domain as DOMAIN
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_FROM_NAME=Your Site Name

# ─── Analytics (Umami) ──────────────────────────────────────────────────────
UMAMI_APP_SECRET=CHANGE_ME_USE_RANDOM_STRING
# Create a website in the Umami dashboard, then put its id here and run `docker compose up -d`
UMAMI_WEBSITE_ID=
# Script host, defaults to https://<DOMAIN>/umami (tracker-only path in Caddyfile.example)
# UMAMI_HOST=

# ─── Admin access control (bundled Caddy) ───────────────────────────────────
# Space separated CIDRs allowed to reach the admin and analytics hosts. Default allows everyone;
# restrict it in production.
# ADMIN_ALLOWED_IPS=203.0.113.0/24

# ─── Host ports (all bound to 127.0.0.1; only needed if you run your own proxy) ─
# API_PORT=5000
# WEB_PORT=3000
# ADMIN_PORT=3001
# UMAMI_PORT=3002
# HTTP_PORT=80
# HTTPS_PORT=443
