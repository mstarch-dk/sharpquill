# ─────────────────────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT CONFIGURATION (single source of config for docker-compose.yml)
#
#   cp .env.example .env && docker compose up -d
#
# The values below are development defaults; ports are published on 127.0.0.1 only.
# Production uses deploy/.env.example instead (see docs/deployment.md).
# ─────────────────────────────────────────────────────────────────────────────

# Database (an existing dev volume keeps the password it was created with)
POSTGRES_DB=cms
POSTGRES_USER=cms_user
POSTGRES_PASSWORD=cms_password

# API JWT signing secret (min 32 chars). Dev only, use a random value anywhere else.
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef

# First admin account, created by db-init only while the authors table is empty.
# ADMIN_PASSWORD must be at least 12 characters; if unset, a random one is generated and printed once
# in the db-init logs (docker compose logs db-init).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# pgAdmin
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

# Umami analytics (dashboard on UMAMI_PORT). Create a website in the dashboard, then put its id here
# to enable tracking on the public site.
UMAMI_APP_SECRET=umami-dev-secret-change-me
UMAMI_WEBSITE_ID=

# Published ports (all bound to 127.0.0.1)
WEB_PORT=3000
ADMIN_PORT=3001
API_PORT=5000
UMAMI_PORT=3003
PGADMIN_PORT=5050
DB_PORT=5432
