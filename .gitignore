# Docker
.docker/

# Media uploads (managed separately) - only at root level
/uploads/
/media/
# Uploads written by the API in development: keep the directory, never the files
src/backend/api/uploads/*
!src/backend/api/uploads/.gitkeep

# Local settings
appsettings.*.local.json
# Claude Code: share settings.json, agents and skills, keep everything local to the developer out of git
.claude/*
!.claude/settings.json
!.claude/agents/
!.claude/skills/
.claude/settings.local.json

# Private ops notes (never publish)
ops-private/

# Marketing build output (marketing/README.md)
marketing/node_modules/
marketing/site/img/
marketing/demo/images/
marketing/.explore/
